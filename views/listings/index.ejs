<% layout("layouts/boilerplate") -%>

<style>
  #filters {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    align-items: center;
    padding: 0.5rem 0;
    -webkit-overflow-scrolling: touch;
  }
  #filters::-webkit-scrollbar {
    display: none; /* Hide scrollbar for clean look */
  }
  .filter-link {
    text-decoration: none;
    color: #222222 !important;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
    transition: opacity 0.2s;
    flex: 0 0 auto;
  }
  .filter:hover, .filter-link:focus .filter {
    opacity: 1;
    cursor: pointer;
    border-bottom: 2px solid #fe424d;
  }
  .filter p {
    font-size: 0.8rem;
    margin-bottom: 0.25rem;
  }
  .tax-info {
    display: none;
  }
  .tax-toggle {
    border: 1px solid #b0b0b0;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    margin-top: 1rem;
    white-space: nowrap;
  }
  @media (max-width: 991px) {
    .tax-toggle {
      margin-left: 0;
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between">
  <div id="filters">
    <a href="/listings" class="filter-link"><div class="filter"><div><i class="fa-solid fa-list"></i></div><p>All</p></div></a>
    <a href="/listings?category=Trending" class="filter-link"><div class="filter"><div><i class="fa-solid fa-fire"></i></div><p>Trending</p></div></a>
    <a href="/listings?category=Rooms" class="filter-link"><div class="filter"><div><i class="fa-solid fa-bed"></i></div><p>Rooms</p></div></a>
    <a href="/listings?category=Iconic Cities" class="filter-link"><div class="filter"><div><i class="fa-solid fa-mountain-city"></i></div><p>Iconic Cities</p></div></a>
    <a href="/listings?category=Mountains" class="filter-link"><div class="filter"><div><i class="fa-solid fa-mountain"></i></div><p>Mountains</p></div></a>
    <a href="/listings?category=Castles" class="filter-link"><div class="filter"><div><i class="fa-brands fa-fort-awesome"></i></div><p>Castles</p></div></a>
    <a href="/listings?category=Pools" class="filter-link"><div class="filter"><div><i class="fa-solid fa-person-swimming"></i></div><p>Pools</p></div></a>
    <a href="/listings?category=Camping" class="filter-link"><div class="filter"><div><i class="fa-solid fa-campground"></i></div><p>Camping</p></div></a>
    <a href="/listings?category=Farms" class="filter-link"><div class="filter"><div><i class="fa-solid fa-cow"></i></div><p>Farms</p></div></a>
    <a href="/listings?category=Arctic" class="filter-link"><div class="filter"><div><i class="fa-solid fa-snowflake"></i></div><p>Arctic</p></div></a>
    <a href="/listings?category=Domes" class="filter-link"><div class="filter"><div><i class="fa-solid fa-igloo"></i></div><p>Domes</p></div></a>
  </div>

  <div class="tax-toggle ms-auto">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<div class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">
    <% if(allListings.length === 0) { %>
      <div class="col-12 text-center mt-5">
        <h4>No destination found for this filter!</h4>
      </div>
    <% } %>
    <% for(let listing of allListings) { %>
      <div class="col mb-4">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card listing-card h-100 border-0 m-0 position-relative">
            
            <div class="position-absolute top-0 start-0 m-3 px-2 py-1 bg-white rounded-pill shadow-sm" style="z-index: 2; font-size: 0.75rem; font-weight: bold;">
              Guest favourite
            </div>
            
            <div class="position-absolute top-0 end-0 m-3 text-white" style="z-index: 2; font-size: 1.25rem; filter: drop-shadow(0px 2px 4px rgba(0,0,0,0.6));">
              <i class="fa-regular fa-heart"></i>
            </div>

            <div class="img-container style-card-img" style="aspect-ratio: 20 / 19; overflow: hidden; border-radius: 1rem;">
              <img src="<%= listing.image.url %>" class="card-img-top w-100 h-100" alt="listing_image" style="object-fit: cover;">
            </div>
            
            <div class="card-body px-0 pt-2">
              <div class="d-flex justify-content-between align-items-start m-0">
                <h6 class="text-dark font-weight-bold m-0 text-truncate" style="max-width: 80%;"><%= listing.title %></h6>
                <span class="text-dark small"><i class="fa-solid fa-star small"></i> 5.0</span>
              </div>
              <p class="card-text m-0 text-secondary small">
                <%= listing.location %>, <%= listing.country %>
              </p>
              <p class="card-text m-0 mt-1 text-dark">
                <b>&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></b> <span class="text-secondary small">/night</span>
                <i class="tax-info text-danger small">&nbsp;&nbsp; +18% GST</i>
              </p>
            </div>

          </div>
        </a>
      </div> 
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for(let info of taxInfo) {
        info.style.display = (info.style.display !== "inline") ? "inline" : "none";
      }
    });
</script>